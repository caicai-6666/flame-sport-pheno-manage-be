# 应用基础配置
APP_NAME=燃动现象管理端后端
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001
API_PREFIX=/flame/admin/api
PUBLIC_API_PREFIX=/dev/flame/admin/api
CORS_ORIGINS=["http://localhost:5173"]

# 管理端认证配置；设置非空密码且不得提交版本库
ADMIN_KEY=change_me
ADMIN_TOKEN_TTL_SECONDS=28800
ADMIN_TOKEN_CACHE_MAX_SIZE=1000

# 激活赛季配置变更窗口，单位为小时
# 从当前激活赛季开始日 00:00 起计；用于限制等级积分、等级、项目配置和奖品积分等高影响修改，0 表示激活后立即禁止修改
ACTIVE_SEASON_CONFIG_EDIT_WINDOW_HOURS=24

# 赛季状态定时检查；启动时立即执行，随后按秒级间隔轮询
SEASON_STATUS_CHECK_ENABLED=true
SEASON_STATUS_CHECK_INTERVAL_SECONDS=60
SEASON_SETTLEMENT_REVIEW_BATCH_SIZE=100
SEASON_SETTLEMENT_REVIEW_CONCURRENCY=5
SEASON_SETTLEMENT_USER_BATCH_SIZE=100
# 自动一键结算默认关闭；启用后在赛季结束日加指定自然日后的首次轮询执行，0 表示进入结算后立即执行
SEASON_SETTLEMENT_AUTO_COMPLETE_ENABLED=false
SEASON_SETTLEMENT_AUTO_COMPLETE_AFTER_DAYS=7
SEASON_SETTLEMENT_TWO_MONTH_STREAK_BONUS_POINTS=50
SEASON_SETTLEMENT_THREE_MONTH_STREAK_BONUS_POINTS=100

# MySQL 异步连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=flame_sport_pheno
MYSQL_CHARSET=utf8mb4
MYSQL_ECHO=false
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE_SECONDS=1800

# 客户端后端服务配置
# 通过局域网服务名访问客户端后端管理接口
CLIENT_BACKEND_BASE_URL=http://backend:8000/flame/api/admin
CLIENT_BACKEND_TIMEOUT_SECONDS=10

# 图片响应缓存配置；适用于所有图片接口，单位为秒
IMAGE_CACHE_SECONDS=86400

# DeepSeek 模型配置；使用 OpenAI 兼容协议，未启用模型功能时密钥可以留空
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_TIMEOUT_SECONDS=60
# vLLM OpenAI 兼容服务；仅在查询智能体全局供应商选择 vllm 时启用
VLLM_API_KEY=EMPTY
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=deepseek-v4-flash
VLLM_HTTP_TIMEOUT_SECONDS=60
# 查询智能体全局模型供应商；所有子图统一使用 deepseek 或 vllm
AGENT_QUERY_MODEL_PROVIDER=deepseek
# 可选：DeepSeek V4 使用 deepseek-v4.txt，Qwen3.6 使用 qwen3.6.txt；留空表示关闭
AGENT_QUERY_TOOL_TAG_TEMPLATE=deepseek-v4.txt
# 查询智能体各模型阶段的单次生成硬上限。
DEEPSEEK_QUERY_ALIGNMENT_MAX_TOKENS=1200
DEEPSEEK_QUERY_PLANNING_MAX_TOKENS=3000
DEEPSEEK_QUERY_INSPECTION_MAX_TOKENS=800
DEEPSEEK_QUERY_SQL_MAX_TOKENS=1200
DEEPSEEK_QUERY_TRANSLATION_MAX_TOKENS=1000
DEEPSEEK_QUERY_AUDIT_MAX_TOKENS=500
# 正式查询流水线的模型轮次、工具次数和进程内会话资源上限。
AGENT_QUERY_ALIGNMENT_MAX_GENERATIONS=10
AGENT_QUERY_PLANNING_MAX_GENERATIONS=30
AGENT_QUERY_PLANNING_MAX_TOOL_CALLS=60
AGENT_QUERY_SQL_MAX_GENERATIONS=4
AGENT_QUERY_TRANSLATION_MAX_PARALLEL_FIELDS=4
AGENT_QUERY_MAX_ACTIVE_SESSIONS=20
AGENT_QUERY_EVENT_HISTORY_SIZE=200
AGENT_QUERY_SESSION_TTL_SECONDS=3600
AGENT_QUERY_SSE_HEARTBEAT_SECONDS=15
# 查询诊断日志写入 Docker 标准输出；生产排障时临时启用，完成后恢复 false。
AGENT_QUERY_DIAGNOSTIC_LOG_ENABLED=false
AGENT_QUERY_DIAGNOSTIC_LOG_LEVEL=basic
